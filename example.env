# Claude writes the recipes
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL_FAST=claude-haiku-5-5     # first draft
# CLAUDE_MODEL_SMART=claude-sonnet-5-5   # "Neu schreiben"

# Local transcription (Hugging Face ONNX Whisper model, downloaded once into DATA_DIR/models)
LOCAL_TRANSCRIPTION_MODEL=Xenova/whisper-small

# Mealie
MEALIE_URL=http://mealie:9000            # how the container reaches Mealie
EXTERNAL_MEALIE_URL=https://mealie.example.com   # optional, used for "open in Mealie" links
MEALIE_API_KEY=ey...                     # Profile -> API Tokens, no quotes
MEALIE_GROUP_NAME=home

# Optional: Gotify push notifications and the public URL of this app (for links in notifications)
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=
APP_URL=https://social-to-mealie.example.com

# Recipe language for a fresh install (en or de), changeable later in the settings
APP_LANGUAGE=en

# Optional
# DATA_DIR=/app/data
# RETENTION_DAYS=10
YTDLP_VERSION=latest
COOKIES= # cookie string for yt-dlp (NAME=VALUE); alternatively mount cookies.txt
